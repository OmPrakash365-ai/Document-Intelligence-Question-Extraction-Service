# ==============================================================================
# Document Intelligence & Question Extraction Service Configuration
# ==============================================================================

# Application
APP_NAME=Document Intelligence & Question Extraction Service
APP_VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-very-secure-random-secret-key-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_intelligence
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Security & JWT
JWT_SECRET_KEY=replace-with-a-very-secure-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25

# Document & OCR Processing
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
OCR_DPI=300
ENABLE_DESKEW=true
ENABLE_DENOISE=true

# Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.65

# Optional External AI/Vision Provider (isolated behind DocumentUnderstandingProvider)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
